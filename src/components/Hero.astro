---
---

<section class="hero">
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <div class="hero-badge">📍 Brescia</div>
    <h1 class="hero-title">
      Il portale unico per gli <span class="highlight">studenti</span> di Brescia
    </h1>
    <p class="hero-subtitle">
      Trasporti, agevolazioni, eventi, orientamento e tutti i servizi dedicati
      alla vita universitaria nella città di Brescia. Tutto in un'unica piattaforma.
    </p>
    <div class="hero-actions">
      <a href="/servizi" class="btn btn-primary btn-lg">Esplora i servizi</a>
      <a href="/registrati" class="btn btn-outline btn-lg">Crea il tuo account</a>
    </div>

    <div class="hero-stats">
      <div class="hero-stat">
        <strong>15.000+</strong>
        <span>Studenti registrati</span>
      </div>
      <div class="hero-stat">
        <strong>120+</strong>
        <span>Servizi disponibili</span>
      </div>
      <div class="hero-stat">
        <strong>50+</strong>
        <span>Partner convenzionati</span>
      </div>
    </div>
  </div>
</section>
