---
const navItems = [
  { label: "Home", href: "/" },
  { label: "Servizi", href: "/servizi" },
  { label: "Eventi", href: "/eventi" },
  { label: "News", href: "/news" },
  { label: "Orientamento", href: "/orientamento" },
  { label: "Contatti", href: "/contatti" },
];
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      <span class="logo-icon">🎓</span>
      <span class="logo-text">
        <strong>Io Studente</strong>
        <small>Brescia</small>
      </span>
    </a>

    <button class="nav-toggle" aria-label="Apri menu" id="navToggle">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="main-nav" id="mainNav">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "nav-link",
                  { active: Astro.url.pathname === item.href },
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/login" class="btn btn-outline">Accedi</a>
      <a href="/registrati" class="btn btn-primary">Registrati</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("navToggle");
  const nav = document.getElementById("mainNav");
  toggle?.addEventListener("click", () => {
    nav?.classList.toggle("open");
    toggle.classList.toggle("active");
  });
</script>
