---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import EventList from "../components/EventList.astro";
import NewsGrid from "../components/NewsGrid.astro";
---

<BaseLayout
  title="Io Studente Brescia - Portale dei servizi per studenti"
  description="Il portale unico dei servizi per gli studenti di Brescia: trasporti, agevolazioni, eventi, orientamento e molto altro."
>
  <Hero />
  <ServiceGrid />
  <EventList />
  <NewsGrid />

  <section class="cta-section">
    <div class="container">
      <h2>Sei pronto a iniziare?</h2>
      <p>
        Registrati su Io Studente Brescia per accedere a tutti i servizi,
        agevolazioni e opportunità dedicate alla vita universitaria a Brescia.
      </p>
      <a href="/registrati" class="btn btn-outline btn-lg">Registrati gratuitamente</a>
    </div>
  </section>
</BaseLayout>
