---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contatti - Io Studente Brescia"
  description="Contatta il team di Io Studente Brescia per informazioni e supporto."
>
  <section class="page-header">
    <div class="container">
      <h1>Contatti</h1>
      <p>Siamo qui per aiutarti</p>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <h2>📌 Come raggiungerci</h2>
      <p>
        Lo sportello Io Studente Brescia è situato in centro città, facilmente
        raggiungibile con i mezzi pubblici.
      </p>
      <ul>
        <li><strong>Indirizzo:</strong> Piazza della Loggia, Brescia</li>
        <li><strong>Email:</strong> info@iostudentebrescia.it</li>
        <li><strong>Telefono:</strong> 030 0000000</li>
        <li><strong>Orari:</strong> Lunedì - Venerdì, 9:00 - 17:00</li>
      </ul>

      <h2>💬 Inviaci un messaggio</h2>
      <p>
        Compila il modulo sottostante e ti risponderemo entro 48 ore.
      </p>

      <form style="max-width:600px;margin-top:2rem;display:flex;flex-direction:column;gap:1rem;">
        <div>
          <label for="name" style="display:block;margin-bottom:0.5rem;font-weight:600;">Nome</label>
          <input type="text" id="name" name="name" required style="width:100%;padding:0.7rem;border:1px solid var(--color-border);border-radius:6px;font-size:1rem;" placeholder="Il tuo nome" />
        </div>
        <div>
          <label for="email" style="display:block;margin-bottom:0.5rem;font-weight:600;">Email</label>
          <input type="email" id="email" name="email" required style="width:100%;padding:0.7rem;border:1px solid var(--color-border);border-radius:6px;font-size:1rem;" placeholder="La tua email" />
        </div>
        <div>
          <label for="message" style="display:block;margin-bottom:0.5rem;font-weight:600;">Messaggio</label>
          <textarea id="message" name="message" rows="5" required style="width:100%;padding:0.7rem;border:1px solid var(--color-border);border-radius:6px;font-size:1rem;resize:vertical;" placeholder="Il tuo messaggio"></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-lg" style="align-self:flex-start;">Invia messaggio</button>
      </form>
    </div>
  </section>
</BaseLayout>
